# PostgreSQL / Prisma (REQ-O3, design.md §8)
DATABASE_URL=postgresql://cmpc:cmpc@localhost:5432/cmpc_libros

# JWT (REQ-B2, REQ-B8)
JWT_SECRET=change-me-use-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=30m

# Backend HTTP
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Imágenes (supuesto A4)
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=2097152

# Credenciales de Postgres en Docker Compose (servicio db)
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=cmpc
POSTGRES_DB=cmpc_libros
